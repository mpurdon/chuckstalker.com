---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sector Not Found — Chuck Stalker" description="404 — this sector doesn't exist.">
<main>
  <section class="wrap" style="min-height: 55vh; display: flex; align-items: center;">
    <div class="plate rivets dossier-card" style="width: 100%; text-align: center; padding-block: 4rem;">
      <span class="rivet-tr"></span><span class="rivet-bl"></span>
      <img class="widget w-404" src="/images/widgets/404-stamp.webp" alt="" aria-hidden="true" width="70" height="70" />
      <p class="stencil" style="font-size: clamp(1.1rem, 3vw, 1.6rem); color: var(--text-primary);">Sector Not Found</p>
      <p style="margin-top: .75rem; color: var(--text-secondary); max-width: none;">This grid square is unmapped, mined, or classified.</p>
      <a class="cta" href="/"><span>&#9760;</span> Return to base <span class="arrow">&#8594;</span></a>
      <img class="widget w-tooclose" src="/images/widgets/too-close.webp" alt="" aria-hidden="true" width="175" height="143" />
    </div>
  </section>
</main>
</Layout>
